%%{init: {'flowchart': {'curve': 'linear'}}}%%
graph TD;
	__start__([<p>__start__</p>]):::first
	__end__([<p>__end__</p>]):::last
	get_schema(get_schema)
	generate_sql(generate_sql)
	validate_sql(validate_sql)
	execute_query(execute_query)
	correct_sql(correct_sql)
	format_results(format_results)
	__start__ --> get_schema;
	correct_sql --> execute_query;
	format_results --> __end__;
	generate_sql --> validate_sql;
	get_schema -. &nbsp;ok&nbsp; .-> generate_sql;
	get_schema -. &nbsp;error&nbsp; .-> __end__;
	validate_sql -. &nbsp;valid&nbsp; .-> execute_query;
	validate_sql -. &nbsp;invalid&nbsp; .-> __end__;
	execute_query -. &nbsp;success&nbsp; .-> format_results;
	execute_query -. &nbsp;retry&nbsp; .-> correct_sql;
	execute_query -. &nbsp;max_retries&nbsp; .-> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
